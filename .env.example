DOCKER_HOST=/var/run/docker.sock
PUBLIC_WS_URL=wss://devsim.dev
SOCKET_PATH=/var/run/docker.sock

GOOGLE_CLIENT_ID="your google client id"
GOOGLE_CLIENT_SECRET="your google client secret"

AUTH_SECRET="generated auth secret (use vercel auth secret generator)"

DATABASE_URL="postgresql://user:password@localhost:5432/databasename?schema=public"

MISTRAL_API_KEY="your ai api key"
OPENROUTER_API_KEY= "your ai api key"

# Stripe Payment (Learner's Pass)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."
FRONTEND_URL="http://localhost:5173"

# Season Cron (secret for internal automation endpoint)
SEASON_CRON_SECRET="random-secret-token"
# Cron schedule expression (default: hourly at minute 0)
SEASON_CRON_SCHEDULE="0 * * * *"
# Set to false to disable season cron (e.g., in development)
SEASON_CRON_ENABLED=true

NGROK_AUTHTOKEN="get this from dashboard.ngrok.com"

# SMTP for help/support emails
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=notifications@example.com
SMTP_PASS=your-app-password
SMTP_FROM="DevSim <notifications@example.com>"
