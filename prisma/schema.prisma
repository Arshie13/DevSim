generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id           String  @id @default(uuid())
  daily_login_id String? @unique
  email        String  @unique
  name         String
  image        String?
  username     String  @unique
  role         UserRole @default(USER)

  // Leveling System
  xp           Int      @default(0)
  coins        Int      @default(0)
  level        Int      @default(1)
  owned_avatars String[] @default([])

  // Onboarding
  has_completed_onboarding Boolean @default(false)

  // Relations
  daily_login   daily_login?       @relation
  workspaces   workspace[]
  achievements user_achievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model workspace {
  id     String @id @default(cuid())
  user_id String
  level  Int
  status String

  container_id String

  // Current progress tracking
  current_scenario_id String

  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  // Archive fields — used when workspace is saved to a Docker volume before workspace deletion
  volume_name String?
  is_archived Boolean @default(false)

  // Relations
  user     user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  scenario scenario @relation(fields: [current_scenario_id], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  file_changes     user_file_changes[]
  completed_tasks  completed_task[]
  workspace_stacks workspace_stack[]

  @@index([user_id])
}

model scenario {
  id          String @id @default(cuid())
  name        String
  description String
  difficulty  String

  // Learning structure
  epics       epic[]

  // Relations
  levels     level[]
  workspaces workspace[]
}

model epic {
  id          String   @id @default(cuid())
  name        String
  description String
  order       Int      @default(0)
  scenario_id  String
  scenario    scenario @relation(fields: [scenario_id], references: [id], onDelete: Cascade)

  // Relations
  levels level[]

  @@index([scenario_id])
}

model level {
  id               String   @id @default(cuid())
  title            String
  subtitle         String
  order            Int      @default(0)
  sprint_number     Int      @default(1) // Which sprint this level belongs to
  deadline         DateTime
  level_description String
  xp_reward         Int
  coin_reward       Int
  key_takeaways     String
  prerequisites    Json?    // JSON array of prerequisite level IDs

  // Epic linking
  epic_id String?
  epic   epic? @relation(fields: [epic_id], references: [id], onDelete: SetNull)

  scenario_id       String
  scenario         scenario @relation(fields: [scenario_id], references: [id], onDelete: Cascade)

  // Relations
  tasks level_task[]
}

// Tasks associated with a level
model level_task {
  id         String  @id @default(cuid())
  level_id    String
  task_name   String
  user_story  String
  order      Int     @default(0)
  is_complete Boolean @default(false)
  test_type   String   @default("none")

  // Epic linking - optional, for sprint structure
  epic_id String?

  level              level                @relation(fields: [level_id], references: [id], onDelete: Cascade)
  acceptance_criteria acceptance_criteria[] @relation("TaskAcceptanceCriteria")
  hints              hint[]               @relation("TaskHints")

  @@unique([level_id, task_name])
  @@index([level_id])
}

// Acceptance criteria for tasks
model acceptance_criteria {
  id          String  @id @default(cuid())
  task_id      String
  description String
  is_required  Boolean @default(false)
  order       Int     @default(0)

  // Relations
  task level_task @relation(fields: [task_id], references: [id], onDelete: Cascade, name: "TaskAcceptanceCriteria")

  @@index([task_id])
}

// Hints associated with a task
model hint {
  id      String @id @default(cuid())
  task_id  String
  description String
  order   Int    @default(0)

  // Relations
  task level_task @relation(fields: [task_id], references: [id], onDelete: Cascade, name: "TaskHints")

  @@index([task_id])
}

model daily_login {
  id     String   @id @default(cuid())
  date   DateTime
  streak Int      @default(0)
  user_id String   @unique

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model achievement {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  category    String

  // Requirements
  criteria Json // { "type": "task_complete", "count": 5 } or sumn idk

  xp_reward   Int @default(100)
  coin_reward Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user_achievements user_achievement[]

  @@unique([name])
}

model user_achievement {
  id            String   @id @default(cuid())
  user_id        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        user        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([user_id, achievementId])
  @@index([user_id])
}

// File change tracking model
model user_file_changes {
  id          String   @id @default(cuid())
  workspace_id String
  file_path    String
  action      String // "CREATE", "WRITE", "DELETE", "RENAME"
  old_path     String? // For rename operations - stores the original path
  content_hash String? // Optional: hash of file content for change detection
  timestamp   DateTime @default(now())

  // Relations
  workspace workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, timestamp])
}

// Completed tasks for a workspace
model completed_task {
  id          String   @id @default(cuid())
  workspace_id String
  task_name    String
  completedAt DateTime @default(now())

  workspace workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, task_name])
  @@index([workspace_id])
}

// Stack choices for a workspace
model workspace_stack {
  id           String  @id @default(cuid())
  workspace_id  String
  stackName    String
  stackVersion String?

  workspace workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

enum UserRole {
  USER
  ADMIN
}

model app_setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("boolean") // "boolean", "string", "number", "json"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
