generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                 @id @default(uuid())
  dailyLoginId           String?                @unique
  email                  String                 @unique
  name                   String
  image                  String?
  username               String                 @unique
  xp                     Int                    @default(0)
  coins                  Int                    @default(0)
  level                  Int                    @default(1)
  ownedAvatars           String[]               @default([])
  hasCompletedOnboarding Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  AssessmentTopicScore   AssessmentTopicScore[]
  containers             Container[]
  dailyLogin             DailyLogin?
  achievements           UserAchievement[]
}

model Container {
  id                String            @id @default(cuid())
  userId            String
  level             Int
  status            String
  containerId       String
  currentScenarioId String
  startedAt         DateTime          @default(now())
  stoppedAt         DateTime?
  volumeName        String?
  isArchived        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  completedTasks    CompletedTask[]
  scenario          Scenario          @relation(fields: [currentScenarioId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  containerStacks   ContainerStack[]
  fileChanges       UserFileChanges[]

  @@index([userId])
}

model Scenario {
  id          String      @id @default(cuid())
  name        String
  description String
  difficulty  String
  containers  Container[]
  levels      Level[]
}

model Level {
  id               String      @id @default(cuid())
  title            String
  subtitle         String
  order            Int         @default(0)
  deadline         DateTime
  levelDescription String
  xpReward         Int
  coinReward       Int
  keyTakeaways     String
  scenarioId       String
  scenario         Scenario    @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  tasks            LevelTask[]
}

model LevelTask {
  id                 String               @id @default(cuid())
  levelId            String
  taskName           String
  userStory          String
  order              Int                  @default(0)
  isComplete         Boolean              @default(false)
  testType           String               @default("none")
  acceptanceCriteria AcceptanceCriteria[] @relation("TaskAcceptanceCriteria")
  hints              Hint[]               @relation("TaskHints")
  level              Level                @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([levelId, taskName])
  @@index([levelId])
}

model AcceptanceCriteria {
  id          String    @id @default(cuid())
  taskId      String
  description String
  isRequired  Boolean   @default(false)
  order       Int       @default(0)
  task        LevelTask @relation("TaskAcceptanceCriteria", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Hint {
  id          String    @id @default(cuid())
  taskId      String
  description String
  order       Int       @default(0)
  task        LevelTask @relation("TaskHints", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model DailyLogin {
  id     String   @id @default(cuid())
  date   DateTime
  streak Int      @default(0)
  userId String   @unique
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String
  icon             String
  category         String
  criteria         Json
  xpReward         Int               @default(100)
  coinReward       Int               @default(50)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserFileChanges {
  id          String    @id @default(cuid())
  containerId String
  filePath    String
  action      String
  oldPath     String?
  contentHash String?
  timestamp   DateTime  @default(now())
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId, timestamp])
}

model CompletedTask {
  id          String    @id @default(cuid())
  containerId String
  taskName    String
  completedAt DateTime  @default(now())
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@unique([containerId, taskName])
  @@index([containerId])
}

model ContainerStack {
  id           String    @id @default(cuid())
  containerId  String
  stackName    String
  stackVersion String?
  container    Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId])
}

model AssessmentTopicScore {
  id          String   @id
  userId      String
  topic       String
  preScore    Int?
  postScore   Int?
  improvement Int?
  assessedAt  DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId])
}
