generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  dailyLoginId String? @unique
  email        String  @unique
  name         String
  image        String?

  // Leveling System
  xp    Int @default(0)
  coins Int @default(0)
  level Int @default(1)

  // Relations
  dailyLogin         DailyLogin?          @relation
  currentStacks      UserStackOptions[]
  containers         Container[]
  sessions           Session[]
  achievements       UserAchievement[]
  userGeneratedContent UserGeneratedContent[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model UserStackOptions {
  id          String  @id @default(cuid())
  userId      String
  containerId String
  sessionId   String
  scenarioId  String
  stack       Json
  isComplete  Boolean

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  session   Session   @relation(fields: [sessionId], references: [id], onUpdate: Cascade)
  scenario  Scenario  @relation(fields: [scenarioId], references: [id], onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Container {
  id     String @id @default(cuid())
  userId String
  level  Int
  status String

  containerId String

  // Current progress tracking
  currentScenarioId String?
  completedTasks    String[] @default([])

  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  stacks String[]

  // Archive fields — used when workspace is saved to a Docker volume before container deletion
  volumeName String?
  isArchived Boolean @default(false)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  userStackOptions UserStackOptions[]

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  startTime DateTime
  endTime   DateTime
  duration  Int

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userStackOptions UserStackOptions[]

  @@index([userId])
}

model Scenario {
  id          String @id @default(cuid())
  levelId     String
  name        String
  description String
  difficulty  String

  userStackOptions UserStackOptions[]
  level            Level              @relation(fields: [levelId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Level {
  id               String   @id @default(cuid())
  title            String
  order            Int      @default(0) // For ordering levels (1, 2, 3, 4)
  deadline         DateTime
  levelDescription String
  hints            String[]
  xpReward         Int
  coinReward       Int
  task             String[]
  completedTask    String[]

  scenarios Scenario[]
}

model DailyLogin {
  id     String   @id @default(cuid())
  date   DateTime
  streak Int      @default(0)
  userId String   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  category    String

  // Requirements
  criteria Json // { "type": "task_complete", "count": 5 } or sumn idk

  xpReward   Int @default(100)
  coinReward Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAchievements UserAchievement[]

  @@unique([name])
}

model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  achievementId  String
  earnedAt       DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// User Generated Content Models
model UserGeneratedContent {
  id          String   @id @default(cuid())
  userId      String
  repoLink    String
  scenario    String   // Description of what the repo is about / use case
  status      String   @default("pending") // pending, approved, rejected
  isFeatured  Boolean  @default(false)

  // Relations
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  techStacks UGCTechStack[]
  levels     UGCLevel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model UGCTechStack {
  id     String @id @default(cuid())
  ugcId  String
  name   String // e.g., "React", "Node.js", "PostgreSQL"

  // Relations
  ugc UserGeneratedContent @relation(fields: [ugcId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ugcId])
}

model UGCLevel {
  id          String @id @default(cuid())
  ugcId       String
  title       String
  order       Int    @default(0) // For ordering levels (1, 2, 3, 4)
  description String
  xpReward    Int    @default(0)

  // Relations
  ugc   UserGeneratedContent @relation(fields: [ugcId], references: [id], onDelete: Cascade)
  tasks UGCTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ugcId])
}

model UGCTask {
  id          String  @id @default(cuid())
  levelId     String
  title       String
  description String
  hint        String?
  order       Int     @default(0)

  // Relations
  level UGCLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([levelId])
}
