generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  dailyLoginId String? @unique
  email        String  @unique
  name         String
  image        String?

  // Leveling System
  xp    Int @default(0)
  coins Int @default(0)
  level Int @default(1)

  // Relations
  dailyLogin    DailyLogin?       @relation
  currentStacks UserStackOptions[]
  containers    Container[]
  sessions     Session[]
  achievements UserAchievement[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model UserStackOptions {
  id          String  @id @default(cuid())
  userId      String
  containerId String
  sessionId   String
  scenarioId  String
  stack       Json
  isComplete  Boolean

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  session   Session   @relation(fields: [sessionId], references: [id], onUpdate: Cascade)
  scenario  Scenario  @relation(fields: [scenarioId], references: [id], onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Container {
  id     String @id @default(cuid())
  userId String
  level  Int
  status String

  containerId String

  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  stacks String[]

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  userStackOptions UserStackOptions[]

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  startTime DateTime
  endTime   DateTime
  duration  Int

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userStackOptions UserStackOptions[]

  @@index([userId])
}

model Scenario {
  id          String @id @default(cuid())
  levelId     String
  name        String
  description String
  difficulty  String

  userStackOptions UserStackOptions[]
  level            Level              @relation(fields: [levelId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Level {
  id               String   @id @default(cuid())
  title            String
  deadline         DateTime
  levelDescription String
  hints            String[]
  xpReward         Int
  coinReward       Int
  task             String[]
  completedTask    String[]

  scenarios Scenario[]
}

model DailyLogin {
  id     String   @id @default(cuid())
  date   DateTime
  streak Int      @default(0)
  userId String   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  category    String

  // Requirements
  criteria Json // { "type": "task_complete", "count": 5 } or sumn idk

  xpReward   Int @default(100)
  coinReward Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAchievements UserAchievement[]

  @@unique([name])
}

model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  achievementId  String
  earnedAt       DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}
