generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  dailyLoginId String? @unique
  email        String  @unique
  name         String
  image        String?
  username     String  @unique

  // Leveling System
  xp           Int      @default(0)
  coins        Int      @default(0)
  level        Int      @default(1)
  ownedAvatars String[] @default([])

  // Onboarding
  hasCompletedOnboarding Boolean @default(false)

  // Relations
  dailyLogin   DailyLogin?       @relation
  workspaces   Workspace[]
  achievements UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id     String @id @default(cuid())
  userId String
  level  Int
  status String

  containerId String

  // Current progress tracking
  currentScenarioId String

  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  // Archive fields — used when workspace is saved to a Docker volume before workspace deletion
  volumeName String?
  isArchived Boolean @default(false)

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [currentScenarioId], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fileChanges     UserFileChanges[]
  completedTasks  CompletedTask[]
  workspaceStacks WorkspaceStack[]

  @@index([userId])
}

model Scenario {
  id          String @id @default(cuid())
  name        String
  description String
  difficulty  String

  // Learning structure
  epics       Epic[]

  // Relations
  levels     Level[]
  workspaces Workspace[]
}

model Epic {
  id          String   @id @default(cuid())
  name        String
  description String
  order       Int      @default(0)
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  // Relations
  levels Level[]

  @@index([scenarioId])
}

model Level {
  id               String   @id @default(cuid())
  title            String
  subtitle         String
  order            Int      @default(0)
  sprintNumber     Int      @default(1) // Which sprint this level belongs to
  deadline         DateTime
  levelDescription String
  xpReward         Int
  coinReward       Int
  keyTakeaways     String
  prerequisites    Json?    // JSON array of prerequisite level IDs

  // Epic linking
  epicId String?
  epic   Epic? @relation(fields: [epicId], references: [id], onDelete: SetNull)

  scenarioId       String
  scenario         Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  // Relations
  tasks LevelTask[]
}

// Tasks associated with a level
model LevelTask {
  id         String  @id @default(cuid())
  levelId    String
  taskName   String
  userStory  String
  order      Int     @default(0)
  isComplete Boolean @default(false)
  testType   String   @default("none")

  // Epic linking - optional, for sprint structure
  epicId String?

  level              Level                @relation(fields: [levelId], references: [id], onDelete: Cascade)
  acceptanceCriteria AcceptanceCriteria[] @relation("TaskAcceptanceCriteria")
  hints              Hint[]               @relation("TaskHints")

  @@unique([levelId, taskName])
  @@index([levelId])
}

// Acceptance criteria for tasks
model AcceptanceCriteria {
  id          String  @id @default(cuid())
  taskId      String
  description String
  isRequired  Boolean @default(false)
  order       Int     @default(0)

  // Relations
  task LevelTask @relation(fields: [taskId], references: [id], onDelete: Cascade, name: "TaskAcceptanceCriteria")

  @@index([taskId])
}

// Hints associated with a task
model Hint {
  id      String @id @default(cuid())
  taskId  String
  description String
  order   Int    @default(0)

  // Relations
  task LevelTask @relation(fields: [taskId], references: [id], onDelete: Cascade, name: "TaskHints")

  @@index([taskId])
}

model DailyLogin {
  id     String   @id @default(cuid())
  date   DateTime
  streak Int      @default(0)
  userId String   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  category    String

  // Requirements
  criteria Json // { "type": "task_complete", "count": 5 } or sumn idk

  xpReward   Int @default(100)
  coinReward Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAchievements UserAchievement[]

  @@unique([name])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// File change tracking model
model UserFileChanges {
  id          String   @id @default(cuid())
  workspaceId String
  filePath    String
  action      String // "CREATE", "WRITE", "DELETE", "RENAME"
  oldPath     String? // For rename operations - stores the original path
  contentHash String? // Optional: hash of file content for change detection
  timestamp   DateTime @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, timestamp])
}

// Completed tasks for a workspace
model CompletedTask {
  id          String   @id @default(cuid())
  workspaceId String
  taskName    String
  completedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, taskName])
  @@index([workspaceId])
}

// Stack choices for a workspace
model WorkspaceStack {
  id           String  @id @default(cuid())
  workspaceId  String
  stackName    String
  stackVersion String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
