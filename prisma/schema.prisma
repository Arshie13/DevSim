generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum LearningSectionType {
  PLAIN_TEXT
  INTERACTIVE
}

enum LearningInteractiveMode {
  TERMINAL_CD
  CODE_EDITOR
}

enum achievement_tier_level {
  ROOKIE
  AMATEUR
  PRO
}

model user {
  id           String  @id @default(uuid())
  daily_login_id String? @unique
  email        String  @unique
  name         String
  image        String?
  username     String  @unique
  role         UserRole @default(USER)

  // Leveling System
  xp           Int      @default(0)
  coins        Int      @default(0)
  level        Int      @default(1)
  owned_avatars String[] @default([])
  
  // Tutorial
  has_completed_tutorial Boolean @default(false)

  // Relations
  daily_login   daily_login?       @relation
  workspaces   workspace[]
  achievements user_achievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentTopicScores assessment_topic_score[]
}

model workspace {
  id     String @id @default(cuid())
  user_id String
  level  Int
  status String

  container_id String

  // Current progress tracking
  current_scenario_id String

  started_at DateTime  @default(now())
  stopped_at DateTime?

  // Archive fields — used when workspace is saved to a Docker volume before workspace deletion
  volume_name String?
  is_archived Boolean @default(false)

  // Relations
  user     user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  scenario scenario @relation(fields: [current_scenario_id], references: [id])

  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  file_changes     user_file_changes[]
  completed_tasks  completed_task[]
  workspace_stacks workspace_stack[]

  @@index([user_id])
}

model scenario {
  id          String @id @default(cuid())
  name        String
  description String
  difficulty  String

  // Learning structure
  epics       epic[]

  // Relations
  levels     level[]
  workspaces workspace[]
}

model epic {
  id          String   @id @default(cuid())
  name        String
  description String
  order       Int      @default(0)
  scenario_id  String
  scenario    scenario @relation(fields: [scenario_id], references: [id], onDelete: Cascade)

  // Relations
  levels level[]

  @@index([scenario_id])
}

model level {
  id               String   @id @default(cuid())
  title            String
  subtitle         String
  order            Int      @default(0)
  sprint_number     Int      @default(1) // Which sprint this level belongs to
  deadline         DateTime
  level_description String
  xp_reward         Int
  coin_reward       Int
  key_takeaways     String
  // prerequisites    Json?    // JSON array of prerequisite level IDs

  // Epic linking
  epic_id String?
  epic   epic? @relation(fields: [epic_id], references: [id], onDelete: SetNull)

  scenario_id       String
  scenario         scenario @relation(fields: [scenario_id], references: [id], onDelete: Cascade)

  // Relations
  tasks level_task[]
}

// Tasks associated with a level
model level_task {
  id         String  @id @default(cuid())
  level_id    String
  task_name   String
  user_story  String
  order      Int     @default(0)
  is_complete Boolean @default(false)
  test_type   String   @default("none")

  // Epic linking - optional, for sprint structure
  epic_id String?

  level              level                @relation(fields: [level_id], references: [id], onDelete: Cascade)
  acceptance_criteria acceptance_criteria[] @relation("TaskAcceptanceCriteria")
  hints              hint[]               @relation("TaskHints")
  learning_sections   learning_section[]

  @@unique([level_id, task_name])
  @@index([level_id])
}

model learning_section {
  id                String                   @id @default(cuid())
  task_id            String
  title             String
  content           String
  order             Int                      @default(0)
  section_type       LearningSectionType      @default(PLAIN_TEXT)
  interactive_mode   LearningInteractiveMode?
  interactive_config Json?

  task level_task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
}

// Acceptance criteria for tasks
model acceptance_criteria {
  id          String  @id @default(cuid())
  task_id      String
  description String
  is_required  Boolean @default(false)
  order       Int     @default(0)

  // Relations
  task level_task @relation(fields: [task_id], references: [id], onDelete: Cascade, name: "TaskAcceptanceCriteria")

  @@index([task_id])
}

// Hints associated with a task
model hint {
  id      String @id @default(cuid())
  task_id  String
  description String
  order       Int    @default(0)

  // Relations
  task level_task @relation(fields: [task_id], references: [id], onDelete: Cascade, name: "TaskHints")

  // icon        String
  // category    String

  @@index([task_id])
}

model daily_login {
  id            String   @id @default(cuid())
  date          DateTime
  streak        Int      @default(0)
  user_id       String   @unique
  claimedDays   Int[]    @default([])  // Indices 0-6 for days 1-7
  currentDay    Int      @default(1)   // First unclaimed day number (1..8, where 8 = all claimed)
  lastClaimedAt DateTime?

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model achievement {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  category    String

  // Requirements
  // criteria Json // { "type": "task_complete", "count": 5 } or sumn idk

  xp_reward   Int @default(100)
  coin_reward Int @default(50)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_achievements user_achievement[]
  tiers            achievement_tier[]

  @@unique([name])
}

model achievement_tier {
  id             String               @id @default(cuid())
  achievement_id String
  tier           achievement_tier_level
  description    String
  icon           String?
  criteria       Json
  xp_reward      Int                  @default(100)
  coin_reward    Int                  @default(50)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  achievement achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)

  @@unique([achievement_id, tier])
  @@index([achievement_id])
  @@map("achievement_tiers")
}

model user_achievement {
  id             String               @id @default(cuid()) @map("id")
  user_id        String               @map("user_id")
  achievement_id String
  tier           achievement_tier_level
  description    String
  icon           String?
  criteria       Json
  xp_reward      Int                  @default(100)
  coin_reward    Int                  @default(50)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  achievement achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)

  @@unique([achievement_id, tier], map: "user_achievement_achievement_id_tier_key")
  @@index([achievement_id], map: "user_achievement_achievement_id_idx")
  @@map("user_achievement_tiers")
  users user[]
}

// File change tracking model
model user_file_changes {
  id          String   @id @default(cuid())
  workspace_id String
  file_path    String
  action      String // "CREATE", "WRITE", "DELETE", "RENAME"
  old_path     String? // For rename operations - stores the original path
  content_hash String? // Optional: hash of file content for change detection
  timestamp   DateTime @default(now())

  // Relations
  workspace workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, timestamp])
}

// Completed tasks for a workspace
model completed_task {
  id          String   @id @default(cuid())
  workspace_id String
  task_name    String
  completed_at DateTime @default(now())

  workspace workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, task_name])
  @@index([workspace_id])
}

// Stack choices for a workspace
model workspace_stack {
  id           String  @id @default(cuid())
  workspace_id  String
  stack_name    String
  stack_version String?

  workspace workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model app_setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("boolean") // "boolean", "string", "number", "json"

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model assessment_topic_score {
  id          String   @id
  user_id      String
  topic       String
  pre_score    Int?
  post_score   Int?
  improvement Int?
  assessed_at  DateTime @default(now())
  user        user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, topic])
  @@index([user_id])
}

