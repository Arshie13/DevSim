generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// User & Auth
// ────────────────────────────────────────────────────────────────────────────

model user {
  id                            String                    @id @default(uuid()) @map("id")
  email                         String                    @unique @map("email")
  name                          String                    @map("name")
  image                         String?                   @map("image")
  username                      String                    @unique @map("username")
  xp                            Int                       @default(0) @map("xp")
  coins                         Int                       @default(0) @map("coins")
  owned_avatars                 String[]                  @default([]) @map("owned_avatars")
  created_at                    DateTime                  @default(now()) @map("created_at")
  updated_at                    DateTime                  @updatedAt @map("updated_at")
  role                          String                    @default("USER") @map("role")
  titles                        String[]                  @default([]) @map("titles")
  has_completed_tutorial        Boolean                   @default(false) @map("has_completed_tutorial")
  trivia_correct_count          Int                       @default(0) @map("trivia_correct_count")
  has_seen_dashboard_onboarding Boolean                   @default(false) @map("has_seen_dashboard_onboarding")
  daily_ai_help_used            Int                       @default(0) @map("daily_ai_help_used")
  ai_help_credits               Int                       @default(0) @map("ai_help_credits")
  daily_login                   daily_login?              @relation
  workspaces                    workspace[]
  task_activity                 task_activity[]
  achievements                  user_achievement[]
  learner_pass_enrollments      learner_pass_enrollment[] @relation("learner_pass_enrollments")
  user_project_access           user_project_access[]     @relation("user_project_access")
  assessment_topic_scores       assessment_topic_score[]
  coin_purchases                coin_purchase[]           @relation("coin_purchases")
  help_requests                 help_request[]

  @@map("users")
}

// ────────────────────────────────────────────────────────────────────────────
// Workspace
// ────────────────────────────────────────────────────────────────────────────

model workspace {
  id                  String    @id @default(cuid()) @map("id")
  user_id             String    @map("user_id")
  level               Int       @map("level")
  status              String    @map("status")
  container_id        String    @map("container_id")
  volume_name         String?   @map("volume_name")
  current_scenario_id String    @map("current_scenario_id")
  is_archived         Boolean   @default(false) @map("is_archived")
  created_at          DateTime  @default(now()) @map("created_at")
  started_at          DateTime  @default(now()) @map("started_at")
  stopped_at          DateTime? @map("stopped_at")
  updated_at          DateTime  @updatedAt @map("updated_at")
  stack_name          String?   @map("stack_name")
  stack_version       String?   @map("stack_version")

  /// Board state: task names completed in the current level. Cleared on level
  /// advance. Replaces the old completed_task table.
  completed_tasks String[] @default([]) @map("completed_tasks")

  file_changes file_changes[]
  scenario     scenario       @relation(fields: [current_scenario_id], references: [id], onDelete: Restrict)
  user         user           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([current_scenario_id])
  @@map("workspaces")
}

// ────────────────────────────────────────────────────────────────────────────
// Scenario & Levels
// ────────────────────────────────────────────────────────────────────────────

model scenario {
  id           String      @id @default(cuid()) @map("id")
  name         String      @map("name")
  description  String      @map("description")
  difficulty   String      @map("difficulty")
  is_paywalled Boolean     @default(false) @map("is_paywalled")
  levels       level[]
  workspaces   workspace[]

  @@map("scenarios")
}

model level {
  id                String       @id @default(cuid()) @map("id")
  title             String       @map("title")
  subtitle          String       @map("subtitle")
  order             Int          @default(0) @map("order")
  sprint_number     Int          @default(1) @map("sprint_number")
  deadline          DateTime     @map("deadline")
  level_description String       @map("level_description")
  xp_reward         Int          @map("xp_reward")
  coin_reward       Int          @map("coin_reward")
  key_takeaways     String       @map("key_takeaways")
  scenario_id       String       @map("scenario_id")
  scenario          scenario     @relation(fields: [scenario_id], references: [id], onDelete: Cascade)
  tasks             level_task[]

  @@index([id])
  @@index([scenario_id])
  @@map("levels")
}

model level_task {
  id         String @id @default(cuid()) @map("id")
  level_id   String @map("level_id")
  task_name  String @map("task_name")
  user_story String @map("user_story")
  order      Int    @default(0) @map("order")

  /// Template default. Per-workspace board state is tracked in
  /// workspace.completed_tasks; this column serves only as a seed/fallback.
  is_complete Boolean @default(false) @map("is_complete")

  test_type           String                @default("none") @map("test_type")
  acceptance_criteria acceptance_criteria[] @relation("TaskAcceptanceCriteria")
  hints               hint[]                @relation("TaskHints")
  learning_sections   learning_section[]
  level               level                 @relation(fields: [level_id], references: [id], onDelete: Cascade)

  @@unique([level_id, task_name])
  @@index([level_id])
  @@map("level_tasks")
}

model learning_section {
  id               String  @id @default(cuid()) @map("id")
  task_id          String  @map("task_id")
  title            String  @map("title")
  content          String  @map("content")
  order            Int     @default(0) @map("order")
  section_type     String  @default("PLAIN_TEXT") @map("section_type")
  interactive_mode String? @map("interactive_mode")

  /// Expected shape when interactive_mode is "QUIZ":
  /// { questions: { question: string; options: string[]; correct: number }[] }
  /// For "STORY": { branches: { id: string; text: string; choices: { text: string; nextId: string }[] }[] }
  interactive_config Json? @map("interactive_config")

  task level_task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@map("learning_sections")
}

model acceptance_criteria {
  id          String     @id @default(cuid()) @map("id")
  task_id     String     @map("task_id")
  description String     @map("description")
  is_required Boolean    @default(false) @map("is_required")
  order       Int        @default(0) @map("order")
  task        level_task @relation("TaskAcceptanceCriteria", fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@map("acceptance_criteria")
}

model hint {
  id          String     @id @default(cuid()) @map("id")
  task_id     String     @map("task_id")
  description String     @map("description")
  order       Int        @default(0) @map("order")
  task        level_task @relation("TaskHints", fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@map("hints")
}

// ────────────────────────────────────────────────────────────────────────────
// Daily Login Rewards
// ────────────────────────────────────────────────────────────────────────────

model daily_login {
  id      String   @id @default(cuid()) @map("id")
  date    DateTime @map("date")
  streak  Int      @default(0) @map("streak")
  user_id String   @unique @map("user_id")

  /// Actual claim timestamps for each day claimed this cycle (Monday–Sunday).
  /// Replaces the old Int[] day-indices. Use getDay() to recover the weekday.
  claimed_days DateTime[] @default([]) @map("claimed_days")

  /// Cycle position (1-7). NOT a date — this is an integer counter tracking
  /// which day of the 7-day cycle the user is on. Resets after day 7.
  /// Distinct from streak (consecutive login days).
  current_day Int @default(1) @map("current_day")

  last_claimed_at DateTime? @map("last_claimed_at")
  user            user      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("daily_logins")
}

// ────────────────────────────────────────────────────────────────────────────
// Achievements
// ────────────────────────────────────────────────────────────────────────────

model achievement {
  id          String             @id @default(cuid()) @map("id")
  name        String             @unique @map("name")
  description String             @map("description")
  icon        String             @map("icon")
  category    String             @map("category")
  xp_reward   Int                @default(100) @map("xp_reward")
  coin_reward Int                @default(50) @map("coin_reward")
  created_at  DateTime           @default(now()) @map("created_at")
  updated_at  DateTime           @updatedAt @map("updated_at")
  tiers       achievement_tier[]

  @@map("achievements")
}

model achievement_tier {
  id             String  @id @default(cuid()) @map("id")
  achievement_id String  @map("achievement_id")
  tier           String  @map("tier")
  description    String  @map("description")
  icon           String? @map("icon")

  /// Expected shape: { type: string; count?: number; days?: number; xp?: number; coins?: number }
  /// Known types: scenarios_in_stack, distinct_stacks, tasks_completed,
  /// levels_completed, scenarios_completed, login_streak, xp_total,
  /// coins_earned, file_edits, tutorial_completed, trivia_correct
  criteria Json @map("criteria")

  xp_reward   Int                @default(100) @map("xp_reward")
  coin_reward Int                @default(50) @map("coin_reward")
  created_at  DateTime           @default(now()) @map("created_at")
  updated_at  DateTime           @updatedAt @map("updated_at")
  achievement achievement        @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  unlocks     user_achievement[]

  @@unique([achievement_id, tier])
  @@index([achievement_id])
  @@map("achievement_tiers")
}

/// Junction table: links a user to an unlocked achievement_tier.
/// No duplicated tier metadata — join through `tier` instead.
model user_achievement {
  id                  String           @id @default(cuid()) @map("id")
  user_id             String           @map("user_id")
  achievement_tier_id String           @map("achievement_tier_id")
  created_at          DateTime         @default(now()) @map("created_at")
  updated_at          DateTime         @updatedAt @map("updated_at")
  tier                achievement_tier @relation(fields: [achievement_tier_id], references: [id], onDelete: Cascade)
  user                user             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, achievement_tier_id])
  @@index([user_id])
  @@index([achievement_tier_id])
  @@map("user_achievements")
}

// ────────────────────────────────────────────────────────────────────────────
// File Changes
// ────────────────────────────────────────────────────────────────────────────

model file_changes {
  id           String    @id @default(cuid()) @map("id")
  workspace_id String    @map("workspace_id")
  file_path    String    @map("file_path")
  action       String    @map("action")
  old_path     String?   @map("old_path")
  content_hash String?   @map("content_hash")
  timestamp    DateTime  @default(now()) @map("timestamp")
  workspace    workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, timestamp])
  @@map("file_changes")
}

// ────────────────────────────────────────────────────────────────────────────
// Task Activity (durable append-only log + per-workspace board state)
// ────────────────────────────────────────────────────────────────────────────

/// Durable, append-only log of every task a user completes. This is the source
/// of truth for the dashboard weekly chart, activity feed, and lifetime tasks-
/// completed stat. Per-workspace board state is tracked via workspace.completed_tasks.
model task_activity {
  id           String   @id @default(cuid()) @map("id")
  user_id      String   @map("user_id")
  task_name    String   @map("task_name")
  level        Int      @map("level")
  completed_at DateTime @default(now()) @map("completed_at")
  user         user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, completed_at])
  @@map("task_activities")
}

// ────────────────────────────────────────────────────────────────────────────
// Assessments
// ────────────────────────────────────────────────────────────────────────────

model assessment_topic_score {
  id          String   @id @map("id")
  user_id     String   @map("user_id")
  topic       String   @map("topic")
  pre_score   Int?     @map("pre_score")
  post_score  Int?     @map("post_score")
  assessed_at DateTime @default(now()) @map("assessed_at")
  user        user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, topic])
  @@index([user_id])
  @@map("assessment_topic_scores")
}

// ────────────────────────────────────────────────────────────────────────────
// Learner Pass
// ────────────────────────────────────────────────────────────────────────────

model learner_pass_enrollment {
  id         String    @id @default(cuid()) @map("id")
  user_id    String    @map("user_id")
  started_at DateTime? @map("started_at")
  expires_at DateTime? @map("expires_at")
  streak     Int       @default(0) @map("streak")

  /// Reward day numbers claimed (1-30). Allows back-filling past days.
  claimed_day_numbers Int[] @default([]) @map("claimed_days")

  last_claimed_at    DateTime? @map("last_claimed_at")
  payment_id         String?   @unique @map("payment_id")
  payment_provider   String    @default("stripe") @map("payment_provider")

  /// Scenario IDs the user chose to unlock on special days (days 6,12,18,24,30).
  unlock_choices Json @default("[]") @map("unlock_choices")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  user                user                    @relation("learner_pass_enrollments", fields: [user_id], references: [id], onDelete: Cascade)
  project_access      user_project_access[]   @relation("learner_pass_project_access")

  @@index([user_id])
  @@index([expires_at])
  @@index([payment_id])
  @@map("learner_pass_enrollments")
}

model learner_pass_reward {
  id                String   @id @default(cuid()) @map("id")
  reward_index      Int      @unique @map("reward_index") // 1..30
  coins             Int      @default(0) @map("coins")
  xp                Int      @default(0) @map("xp")
  ai_helps          Int      @default(0) @map("ai_helps")
  unlocked_scenario String[] @default([]) @map("unlocked_scenario")
  display_type      String   @default("") @map("display_type")
  display_value     String   @default("") @map("display_value")
  created_at        DateTime @default(now()) @map("created_at")
  updated_at        DateTime @updatedAt @map("updated_at")

  @@map("learner_pass_rewards")
}

// ────────────────────────────────────────────────────────────────────────────
// Project Access (unlocks via Learner Pass, purchase, or admin grant)
// ────────────────────────────────────────────────────────────────────────────

model user_project_access {
  id                         String                     @id @default(cuid()) @map("id")
  user_id                    String                     @map("user_id")
  project_id                 String                     @map("project_id") // references scenario.id
  source                     String                     @map("source") // LEARNER_PASS, COIN_PURCHASE, ADMIN_GRANT
  learner_pass_enrollment_id String?                    @map("learner_pass_enrollment_id")
  coin_purchase_id           String?                    @map("coin_purchase_id")
  granted_at                 DateTime                   @default(now()) @map("granted_at")
  expires_at                 DateTime?                  @map("expires_at") // null = permanent unlock
  user                       user                       @relation("user_project_access", fields: [user_id], references: [id], onDelete: Cascade)
  learner_pass_enrollment    learner_pass_enrollment?   @relation("learner_pass_project_access", fields: [learner_pass_enrollment_id], references: [id], onDelete: Cascade)
  coin_purchase              coin_purchase?             @relation("coin_purchase_project_access", fields: [coin_purchase_id], references: [id], onDelete: Cascade)

  @@unique([user_id, project_id, source])
  @@index([user_id])
  @@index([project_id])
  @@index([source])
  @@index([learner_pass_enrollment_id])
  @@index([coin_purchase_id])
  @@map("user_project_access")
}

// ────────────────────────────────────────────────────────────────────────────
// Coin Purchases
// ────────────────────────────────────────────────────────────────────────────

model coin_purchase {
  id          String   @id @default(cuid()) @map("id")
  user_id     String   @map("user_id")
  payment_id  String   @unique @map("payment_id")
  coin_amount Int      @map("coin_amount")
  created_at  DateTime @default(now()) @map("created_at")
  user                user                    @relation("coin_purchases", fields: [user_id], references: [id], onDelete: Cascade)
  project_access      user_project_access[]   @relation("coin_purchase_project_access")

  @@index([user_id])
  @@map("coin_purchases")
}

// ────────────────────────────────────────────────────────────────────────────
// App Settings
// ────────────────────────────────────────────────────────────────────────────

model app_setting {
  id         String   @id @default(cuid()) @map("id")
  key        String   @unique @map("key")
  value      String   @map("value")
  type       String   @map("type")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ────────────────────────────────────────────────────────────────────────────
// Help Requests
// ────────────────────────────────────────────────────────────────────────────

model help_request {
  id          String   @id @default(cuid()) @map("id")
  userId      String   @map("user_id")
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String?  @map("category")
  subject     String   @map("subject")
  description String   @map("description")
  context     Json?    @map("context")
  status      String   @default("open") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("help_requests")
}
